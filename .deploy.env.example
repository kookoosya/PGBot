# Локальный файл для агента (не коммитить). Скопируйте из .deploy.env.example
SSHPASS=
VPS_HOST=192.210.213.135
VPS_USER=root

# Cloudflare API — для автопереключения DNS на «серое облако» (доступ из РФ)
# Cloudflare → My Profile → API Tokens → Create → Edit zone DNS → pushkinskie-gory.xyz
CF_API_TOKEN=

# VK (бот + афиша)
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_EVENTS_TOKEN=

# Афиша (опционально)
TIMEPAD_API_TOKEN=
PROCULTURE_API_KEY=
POLLINATIONS_API_KEY=sk_your_key_here

# Опционально — прямой Google Gemini (aistudio.google.com)
GEMINI_API_KEY=AIza_your_key_here
